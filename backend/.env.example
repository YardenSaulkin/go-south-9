# Copy this file to .env. These values are from the Go-South-Prod Supabase
# project dashboard. Never commit real credentials.

# Use the Supabase PostgreSQL connection string for the application/ORM.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: use the direct (non-pooled) Supabase connection for future
# introspection commands. The current schema only requires DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
