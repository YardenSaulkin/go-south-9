# Copy this file to .env. These values are from the Go-South-Prod Supabase
# project dashboard. Never commit real credentials.

# Use the Supabase PostgreSQL connection string for the application/ORM.
# Port 6543 is Supabase's transaction pooler, which is what Prisma should run
# against: port 5432 (the session pooler) holds one server connection per
# client and runs out once a few dev servers are up — it then fails with
# "Can't reach database server", even though the host is reachable.
# `pgbouncer=true` disables prepared statements, which transaction pooling
# does not support.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# The session/direct connection (port 5432), used for migrations and
# introspection — those need a session the transaction pooler cannot give.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: enables the photo analysis behind "צלם וטפל" (Claude vision).
# Without it the report flow still works — the analysis step opens as an
# editable empty draft instead of pre-filled findings.
ANTHROPIC_API_KEY=""
