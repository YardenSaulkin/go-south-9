generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgScopeLevel {
  mador
  team

  @@map("org_scope_level")
}


enum UserRole {
  admin
  poc
  normal

  @@map("user_role")
}

enum ShipmentStatus {
  not_sent
  sent
  arrived
  verified

  @@map("shipment_status")
}

enum PackingUnitStatus {
  not_sent
  assigned_to_shipment
  in_transit
  arrived_pending_verification
  verified

  @@map("packing_unit_status")
}

enum ItemStatus {
  not_sent
  assigned_to_packing_unit
  in_transit
  arrived_pending_verification
  verified

  @@map("item_status")
}

enum PackingUnitType {
  personal_carton
  professional_carton
  pallet
  dolav
  bulk

  @@map("packing_unit_type")
}

enum TransportType {
  truck
  other

  @@map("transport_type")
}

enum DiscrepancyKind {
  missing_packing_unit
  missing_item
  excess_item

  @@map("discrepancy_kind")
}

enum DiscrepancyStatus {
  pending
  resolved
  finalized

  @@map("discrepancy_status")
}

enum ReservationStatus {
  booked
  cancelled

  @@map("reservation_status")
}

enum ReportUrgency {
  low
  medium
  high

  @@map("report_urgency")
}

enum ReportStatus {
  open
  assigned
  in_progress
  resolved

  @@map("report_status")
}

enum ReportCategory {
  office_equipment
  air_conditioning
  lighting
  electricity
  plumbing
  network
  furniture
  cleaning
  other

  @@map("report_category")
}

model OrgScope {
  id          String        @id @default(uuid()) @db.Uuid
  scopeLevel  OrgScopeLevel @map("scope_level")
  mador       String
  orgCode     String?       @map("org_code") @db.Char(8)
  description String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  shipments    Shipment[]
  packingUnits PackingUnit[]
  items        Item[]

  @@map("org_scopes")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  personalNumber  String?  @unique @map("personal_number")
  role            UserRole
  orgCode         String?  @map("org_code") @db.Char(8)
  orgScopeId      String?  @map("org_scope_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgScope               OrgScope?          @relation(fields: [orgScopeId], references: [id])
  createdBy              User?              @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers           User[]             @relation("UserCreatedBy")
  ownedShipments         Shipment[]         @relation("ShipmentOwner")
  createdShipments       Shipment[]         @relation("ShipmentCreator")
  ownedPackingUnits      PackingUnit[]      @relation("PackingUnitOwner")
  createdPackingUnits    PackingUnit[]      @relation("PackingUnitCreator")
  ownedItems             Item[]             @relation("ItemOwner")
  createdItems           Item[]             @relation("ItemCreator")
  createdDiscrepancies   Discrepancy[]      @relation("DiscrepancyCreator")
  finalizedDiscrepancies Discrepancy[]      @relation("DiscrepancyFinalizer")
  operationRequests      OperationRequest[]
  operationEvents        OperationEvent[]
  roomReservations       RoomReservation[]
  facilityReports        FacilityReport[]   @relation("FacilityReportReporter")

  @@map("users")
}

model Shipment {
  id                     String         @id @default(uuid()) @db.Uuid
  description            String
  status                 ShipmentStatus
  sourceDescription      String?        @map("source_description")
  destinationDescription String?        @map("destination_description")
  sourceRoomId           String?        @map("source_room_id")
  destinationRoomId      String?        @map("destination_room_id")
  orgScopeId             String         @map("org_scope_id") @db.Uuid
  ownerUserId            String?        @map("owner_user_id") @db.Uuid
  createdByUserId        String         @map("created_by_user_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  transportType          TransportType? @map("transport_type")
  transportDescription   String?        @map("transport_description")
  vehicleIdentifier      String?        @map("vehicle_identifier")
  transportAt            DateTime?      @map("transport_at") @db.Timestamptz(6)
  idempotencyKey         String?        @unique @map("idempotency_key")

  orgScope      OrgScope      @relation(fields: [orgScopeId], references: [id])
  owner         User?         @relation("ShipmentOwner", fields: [ownerUserId], references: [id])
  createdBy     User          @relation("ShipmentCreator", fields: [createdByUserId], references: [id])
  packingUnits  PackingUnit[]
  discrepancies Discrepancy[]

  @@map("shipments")
}

model PackingUnit {
  id                     String            @id @default(uuid()) @db.Uuid
  description            String
  shipmentId             String?           @map("shipment_id") @db.Uuid
  status                 PackingUnitStatus
  sourceDescription      String?           @map("source_description")
  destinationDescription String?           @map("destination_description")
  sourceRoomId           String?           @map("source_room_id")
  destinationRoomId      String?           @map("destination_room_id")
  orgScopeId             String            @map("org_scope_id") @db.Uuid
  ownerUserId            String?           @map("owner_user_id") @db.Uuid
  createdByUserId        String            @map("created_by_user_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  packingUnitType        PackingUnitType?  @map("packing_unit_type")
  serialNumber           Int?              @unique @default(autoincrement()) @map("serial_number")
  idempotencyKey         String?           @unique @map("idempotency_key")

  shipment      Shipment?     @relation(fields: [shipmentId], references: [id])
  orgScope      OrgScope      @relation(fields: [orgScopeId], references: [id])
  owner         User?         @relation("PackingUnitOwner", fields: [ownerUserId], references: [id])
  createdBy     User          @relation("PackingUnitCreator", fields: [createdByUserId], references: [id])
  items         Item[]
  discrepancies Discrepancy[]

  @@map("packing_units")
}

model Item {
  id                     String     @id @default(uuid()) @db.Uuid
  description            String
  packingUnitId          String?    @map("packing_unit_id") @db.Uuid
  status                 ItemStatus
  sourceMappingReportId  String?    @map("source_mapping_report_id")
  sourceRoomId           String?    @map("source_room_id")
  sourceDescription      String?    @map("source_description")
  destinationRoomId      String?    @map("destination_room_id")
  destinationDescription String?    @map("destination_description")
  orgScopeId             String     @map("org_scope_id") @db.Uuid
  ownerUserId            String?    @map("owner_user_id") @db.Uuid
  createdByUserId        String?    @map("created_by_user_id") @db.Uuid
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  quantity               Int        @default(1)
  distributedQuantity    Int        @default(0) @map("distributed_quantity")

  packingUnit   PackingUnit?  @relation(fields: [packingUnitId], references: [id])
  orgScope      OrgScope      @relation(fields: [orgScopeId], references: [id])
  owner         User?         @relation("ItemOwner", fields: [ownerUserId], references: [id])
  createdBy     User?         @relation("ItemCreator", fields: [createdByUserId], references: [id])
  discrepancies Discrepancy[]

  @@map("items")
}

view UserAccessProfile {
  userId                          String    @map("user_id") @db.Uuid
  role                            UserRole
  accessMador                     String?   @map("access_mador")
  accessUnitCode                  String?   @map("access_unit_code")
  canCreateShipments              Boolean   @map("can_create_shipments")
  canCreatePackingUnits           Boolean   @map("can_create_packing_units")
  canViewShipments                Boolean   @map("can_view_shipments")
  canViewPackingUnits             Boolean   @map("can_view_packing_units")
  canViewGlobalShipmentsDashboard Boolean   @map("can_view_global_shipments_dashboard")
  canApproveShipments             Boolean   @map("can_approve_shipments")
  dataVisibilityScope             String?   @map("data_visibility_scope")

  @@map("user_access_profiles")
}

model Discrepancy {
  id                String            @id @default(uuid()) @db.Uuid
  kind              DiscrepancyKind
  status            DiscrepancyStatus @default(pending)
  shipmentId        String?           @map("shipment_id") @db.Uuid
  packingUnitId     String?           @map("packing_unit_id") @db.Uuid
  itemId            String?           @map("item_id") @db.Uuid
  expectedQuantity  Int               @map("expected_quantity")
  actualQuantity    Int               @map("actual_quantity")
  createdByUserId   String            @map("created_by_user_id") @db.Uuid
  finalizedByUserId String?           @map("finalized_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  finalizedAt       DateTime?         @map("finalized_at") @db.Timestamptz(6)

  shipment    Shipment?    @relation(fields: [shipmentId], references: [id])
  packingUnit PackingUnit? @relation(fields: [packingUnitId], references: [id])
  item        Item?        @relation(fields: [itemId], references: [id])
  createdBy   User         @relation("DiscrepancyCreator", fields: [createdByUserId], references: [id])
  finalizedBy User?        @relation("DiscrepancyFinalizer", fields: [finalizedByUserId], references: [id])

  @@index([shipmentId, status])
  @@index([packingUnitId, status])
  @@map("discrepancies")
}

model OperationRequest {
  id             String   @id @default(uuid()) @db.Uuid
  operation      String
  idempotencyKey String   @map("idempotency_key")
  actorUserId    String   @map("actor_user_id") @db.Uuid
  result         Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorUserId], references: [id])

  @@unique([operation, idempotencyKey])
  @@map("operation_requests")
}

model OperationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  action        String
  previousState Json?    @map("previous_state")
  nextState     Json?    @map("next_state")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("operation_events")
}

// ─── Facility mode (managing the compound after the move) ────────────────────

// A shared room in the compound. Rooms are a property of the site rather than
// of an org scope, so every signed-in user can search and book them.
model Room {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  building    String
  floor       String
  capacity    Int
  features    String[] @default([])
  imageUrl    String?  @map("image_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservations RoomReservation[]
  reports      FacilityReport[]

  @@index([building, floor])
  @@map("rooms")
}

model RoomReservation {
  id             String            @id @default(uuid()) @db.Uuid
  roomId         String            @map("room_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  title          String?
  attendees      Int?
  startAt        DateTime          @map("start_at") @db.Timestamptz(6)
  endAt          DateTime          @map("end_at") @db.Timestamptz(6)
  status         ReservationStatus @default(booked)
  idempotencyKey String?           @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([roomId, startAt])
  @@index([userId, startAt])
  @@map("room_reservations")
}

// A "צלם וטפל" maintenance call: the photo the AI turned into a structured
// report, plus the handling details the compound team answers on.
model FacilityReport {
  id                    String         @id @default(uuid()) @db.Uuid
  reportNumber          Int            @unique @default(autoincrement()) @map("report_number")
  objectLabel           String         @map("object_label")
  issueDescription      String         @map("issue_description")
  category              ReportCategory
  urgency               ReportUrgency
  status                ReportStatus   @default(open)
  locationDescription   String?        @map("location_description")
  roomId                String?        @map("room_id") @db.Uuid
  photoDataUrl          String?        @map("photo_data_url")
  assignedTeam          String         @map("assigned_team")
  expectedResponseHours Int            @map("expected_response_hours")
  aiConfidence          Float?         @map("ai_confidence")
  aiAnalysis            Json?          @map("ai_analysis")
  reportedByUserId      String         @map("reported_by_user_id") @db.Uuid
  orgScopeId            String?        @map("org_scope_id") @db.Uuid
  idempotencyKey        String?        @unique @map("idempotency_key")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  acknowledgedAt        DateTime?      @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt            DateTime?      @map("resolved_at") @db.Timestamptz(6)

  room       Room? @relation(fields: [roomId], references: [id])
  reportedBy User  @relation("FacilityReportReporter", fields: [reportedByUserId], references: [id])

  @@index([status, createdAt])
  @@index([reportedByUserId, createdAt])
  @@map("facility_reports")
}
